{
 "description": "Byte stream to events. Adjacent passthrough runs are merged. See ../README.md.",
 "cases": [
  {
   "name": "ST terminated",
   "covers": [
    "SYN-FRAME",
    "SYN-ST"
   ],
   "stream": "\u001b]7501;state=idle\u001b\\",
   "expect": [
    {
     "sequence": {
      "report": {
       "state": "idle"
      }
     },
     "terminator": "st"
    }
   ]
  },
  {
   "name": "BEL terminated",
   "covers": [
    "SYN-FRAME",
    "SYN-ST"
   ],
   "stream": "\u001b]7501;state=idle\u0007",
   "expect": [
    {
     "sequence": {
      "report": {
       "state": "idle"
      }
     },
     "terminator": "bel"
    }
   ]
  },
  {
   "name": "query",
   "covers": [
    "SYN-FRAME"
   ],
   "stream": "\u001b]7501;?\u001b\\",
   "expect": [
    {
     "sequence": {
      "feature": {
       "states": [
        "idle",
        "working",
        "done",
        "blocked",
        "error"
       ],
       "kinds": [
        "permission",
        "question",
        "auth"
       ]
      }
     },
     "terminator": "st"
    }
   ],
   "interpretation": "INT-11"
  },
  {
   "name": "surrounding output passes through",
   "covers": [
    "SYN-FRAME"
   ],
   "stream": "a\u001b]7501;state=done\u0007b",
   "expect": [
    {
     "passthrough": "a"
    },
    {
     "sequence": {
      "report": {
       "state": "done"
      }
     },
     "terminator": "bel"
    },
    {
     "passthrough": "b"
    }
   ]
  },
  {
   "name": "two sequences back to back",
   "covers": [
    "SYN-FRAME"
   ],
   "stream": "\u001b]7501;state=working\u001b\\\u001b]7501;state=done\u001b\\",
   "expect": [
    {
     "sequence": {
      "report": {
       "state": "working"
      }
     },
     "terminator": "st"
    },
    {
     "sequence": {
      "report": {
       "state": "done"
      }
     },
     "terminator": "st"
    }
   ]
  },
  {
   "name": "other OSC passes through",
   "covers": [
    "SYN-FRAME"
   ],
   "stream": "\u001b]0;title\u0007\u001b]7;file:///x\u001b\\",
   "expect": [
    {
     "passthrough": "\u001b]0;title\u0007\u001b]7;file:///x\u001b\\"
    }
   ]
  },
  {
   "name": "OSC 75010 is not 7501",
   "covers": [
    "SYN-FRAME"
   ],
   "stream": "\u001b]75010;state=idle\u0007",
   "expect": [
    {
     "passthrough": "\u001b]75010;state=idle\u0007"
    }
   ]
  },
  {
   "name": "OSC 7501 without semicolon is not a report",
   "covers": [
    "SYN-FRAME"
   ],
   "stream": "\u001b]7501\u0007",
   "expect": [
    {
     "passthrough": "\u001b]7501\u0007"
    }
   ]
  },
  {
   "name": "CSI passes through",
   "covers": [
    "SYN-FRAME"
   ],
   "stream": "\u001b[31mred\u001b[0m",
   "expect": [
    {
     "passthrough": "\u001b[31mred\u001b[0m"
    }
   ]
  },
  {
   "name": "discarded report still consumes the sequence",
   "covers": [
    "ST-REQUIRED"
   ],
   "stream": "x\u001b]7501;state=paused\u001b\\y",
   "expect": [
    {
     "passthrough": "x"
    },
    {
     "discard": true,
     "terminator": "st"
    },
    {
     "passthrough": "y"
    }
   ]
  },
  {
   "name": "4096 bytes with BEL accepted",
   "covers": [
    "LIM-SEQUENCE"
   ],
   "stream": "\u001b]7501;state=idle:\u0007",
   "expect": [
    {
     "sequence": {
      "report": {
       "state": "idle"
      }
     },
     "terminator": "bel"
    }
   ]
  },
  {
   "name": "4097 bytes with ST discarded",
   "covers": [
    "LIM-SEQUENCE"
   ],
   "stream": "\u001b]7501;state=idle:\u001b\\",
   "expect": [
    {
     "discard": true,
     "terminator": "st"
    }
   ]
  },
  {
   "name": "very long sequence discarded, output after it kept",
   "covers": [
    "LIM-SEQUENCE"
   ],
   "stream": "\u001b]7501;state=idle:\u0007tail",
   "expect": [
    {
     "discard": true,
     "terminator": "bel"
    },
    {
     "passthrough": "tail"
    }
   ]
  },
  {
   "name": "C0 inside body ignored",
   "covers": [],
   "stream": "\u001b]7501;state=wor\nking\u0000\u0007",
   "expect": [
    {
     "sequence": {
      "report": {
       "state": "working"
      }
     },
     "terminator": "bel"
    }
   ],
   "interpretation": "INT-10"
  },
  {
   "name": "CAN aborts",
   "covers": [],
   "stream": "\u001b]7501;state=idle\u0018after",
   "expect": [
    {
     "passthrough": "after"
    }
   ],
   "interpretation": "INT-10"
  },
  {
   "name": "SUB aborts",
   "covers": [],
   "stream": "\u001b]7501;state=idle\u001aafter",
   "expect": [
    {
     "passthrough": "after"
    }
   ],
   "interpretation": "INT-10"
  },
  {
   "name": "ESC without backslash aborts and restarts",
   "covers": [],
   "stream": "\u001b]7501;state=idle\u001b]7501;state=done\u0007",
   "expect": [
    {
     "sequence": {
      "report": {
       "state": "done"
      }
     },
     "terminator": "bel"
    }
   ],
   "interpretation": "INT-10"
  },
  {
   "name": "ESC abort then CSI passes through",
   "covers": [],
   "stream": "\u001b]7501;state=idle\u001b[1mbold",
   "expect": [
    {
     "passthrough": "\u001b[1mbold"
    }
   ],
   "interpretation": "INT-10"
  },
  {
   "name": "C1 OSC sent as UTF-8 text is not recognized",
   "covers": [],
   "stream": "7501;state=idle",
   "expect": [
    {
     "passthrough": "7501;state=idle"
    }
   ],
   "interpretation": "INT-10"
  },
  {
   "name": "unterminated sequence at end of stream dropped",
   "covers": [
    "SYN-FRAME"
   ],
   "stream": "x\u001b]7501;state=idle",
   "expect": [
    {
     "passthrough": "x"
    }
   ]
  },
  {
   "name": "partial prefix at end of stream passed through",
   "covers": [
    "SYN-FRAME"
   ],
   "stream": "x\u001b]75",
   "expect": [
    {
     "passthrough": "x\u001b]75"
    }
   ]
  }
 ]
}