{
 "description": "Steps applied to one terminal's record set, then the expected records. See ../README.md.",
 "cases": [
  {
   "name": "report replaces the record completely",
   "covers": [
    "REC-REPLACE"
   ],
   "steps": [
    {
     "report": "state=working:app=brew:progress=10:msg=SW5zdGFsbGluZyB1cGRhdGVz"
    },
    {
     "report": "state=done"
    }
   ],
   "expect": {
    "records": [
     {
      "id": null,
      "state": "done"
     }
    ]
   }
  },
  {
   "name": "root and child coexist",
   "covers": [
    "REC-COEXIST"
   ],
   "steps": [
    {
     "report": "state=idle:app=sh"
    },
    {
     "report": "state=blocked:id=worker:kind=question"
    }
   ],
   "expect": {
    "records": [
     {
      "id": null,
      "state": "idle",
      "app": "sh",
      "effective_app": "sh"
     },
     {
      "id": "worker",
      "state": "blocked",
      "kind": "question",
      "effective_app": "sh"
     }
    ]
   }
  },
  {
   "name": "parent need not exist",
   "covers": [
    "REC-PARENT"
   ],
   "steps": [
    {
     "report": "state=working:id=a/b/c"
    }
   ],
   "expect": {
    "records": [
     {
      "id": "a/b/c",
      "state": "working"
     }
    ]
   }
  },
  {
   "name": "app inherited from nearest ancestor",
   "covers": [
    "KEY-APP-INHERIT",
    "REC-HIERARCHY"
   ],
   "steps": [
    {
     "report": "state=working:app=deploy"
    },
    {
     "report": "state=working:id=us"
    },
    {
     "report": "state=working:id=us/a:app=pusher"
    },
    {
     "report": "state=working:id=us/a/b"
    },
    {
     "report": "state=working:id=eu/x"
    }
   ],
   "expect": {
    "records": [
     {
      "id": null,
      "state": "working",
      "app": "deploy",
      "effective_app": "deploy"
     },
     {
      "id": "eu/x",
      "state": "working",
      "effective_app": "deploy"
     },
     {
      "id": "us",
      "state": "working",
      "effective_app": "deploy"
     },
     {
      "id": "us/a",
      "state": "working",
      "app": "pusher",
      "effective_app": "pusher"
     },
     {
      "id": "us/a/b",
      "state": "working",
      "effective_app": "pusher"
     }
    ]
   }
  },
  {
   "name": "no app anywhere",
   "covers": [
    "KEY-APP-INHERIT"
   ],
   "steps": [
    {
     "report": "state=idle:id=a/b"
    }
   ],
   "expect": {
    "records": [
     {
      "id": "a/b",
      "state": "idle"
     }
    ]
   }
  },
  {
   "name": "clear removes the subtree only",
   "covers": [
    "ST-CLEAR",
    "REC-HIERARCHY"
   ],
   "steps": [
    {
     "report": "state=idle"
    },
    {
     "report": "state=idle:id=a"
    },
    {
     "report": "state=idle:id=a/b"
    },
    {
     "report": "state=idle:id=a/b/c"
    },
    {
     "report": "state=idle:id=ab"
    },
    {
     "report": "state=idle:id=b"
    },
    {
     "report": "state=clear:id=a"
    }
   ],
   "expect": {
    "records": [
     {
      "id": null,
      "state": "idle"
     },
     {
      "id": "ab",
      "state": "idle"
     },
     {
      "id": "b",
      "state": "idle"
     }
    ]
   }
  },
  {
   "name": "clear a child keeps its parent",
   "covers": [
    "ST-CLEAR"
   ],
   "steps": [
    {
     "report": "state=idle:id=a"
    },
    {
     "report": "state=idle:id=a/b"
    },
    {
     "report": "state=clear:id=a/b"
    }
   ],
   "expect": {
    "records": [
     {
      "id": "a",
      "state": "idle"
     }
    ]
   }
  },
  {
   "name": "clear without id removes everything",
   "covers": [
    "ST-CLEAR"
   ],
   "steps": [
    {
     "report": "state=idle"
    },
    {
     "report": "state=done:id=a"
    },
    {
     "report": "state=clear"
    }
   ],
   "expect": {
    "records": []
   }
  },
  {
   "name": "clear of missing record is harmless",
   "covers": [
    "ST-CLEAR"
   ],
   "steps": [
    {
     "report": "state=idle"
    },
    {
     "report": "state=clear:id=nope"
    }
   ],
   "expect": {
    "records": [
     {
      "id": null,
      "state": "idle"
     }
    ]
   }
  },
  {
   "name": "process_exit drops working and blocked",
   "covers": [
    "ST-LIFETIME-DROP",
    "ST-LIFETIME-KEEP"
   ],
   "steps": [
    {
     "report": "state=idle:id=i"
    },
    {
     "report": "state=working:id=w"
    },
    {
     "report": "state=blocked:id=b"
    },
    {
     "report": "state=done:id=d"
    },
    {
     "report": "state=error:id=e"
    },
    {
     "event": "process_exit"
    }
   ],
   "expect": {
    "records": [
     {
      "id": "d",
      "state": "done"
     },
     {
      "id": "e",
      "state": "error"
     },
     {
      "id": "i",
      "state": "idle"
     }
    ]
   }
  },
  {
   "name": "prompt drops working and blocked",
