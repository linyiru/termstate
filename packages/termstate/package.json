  "files": ["index.js", "index.d.ts", "README.md"],
  "engines": { "node": ">=18" },
  "dependencies": {
    "osc7501": "0.0.2"
  },
  "keywords": ["osc7501", "program-status", "terminal", "escape-sequence"],
