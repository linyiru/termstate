  "author": "Lawrence Lin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linyiru/termstate.git",
    "directory": "packages/termstate"
  },
  "homepage": "https://github.com/linyiru/termstate#readme",
  "bugs": "https://github.com/linyiru/termstate/issues"
